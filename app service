trigger:
  branches:
    include:
      - main  # Trigger on push to 'main' branch (or adjust as needed)

pool:
  name: 'YourSelfHostedAgentPool'  # Specify the name of your self-hosted agent pool here
  demands:
    - python  # Ensures that the agent has Python installed

variables:
  azureSubscription: 'YourAzureSubscription'  # Your Azure DevOps Service connection name
  appName: 'YourAzureWebAppName'  # The name of your Azure Web App
  resourceGroup: 'YourResourceGroup'  # Resource group name
  location: 'YourLocation'  # Location (e.g., East US, West Europe, etc.)
  pythonVersion: '3.x'  # Python version (e.g., 3.8, 3.9, etc.)

jobs:
- job: BuildAndDeploy
  displayName: 'Build and Deploy Python App to Azure Web App'
  steps:

    # Checkout the repository code
    - task: Checkout@1
      inputs:
        clean: true  # Ensures we have a clean copy of the repo

    # Set up Python environment
    - task: UsePythonVersion@0
      inputs:
        versionSpec: $(pythonVersion)
        addToPath: true  # Adds Python to PATH

    # Install dependencies
    - script: |
        python -m venv venv  # Create virtual environment
        source venv/bin/activate  # Activate the virtual environment
        pip install -r requirements.txt  # Install dependencies from requirements.txt
      displayName: 'Install Python dependencies'

    # Run tests (optional but highly recommended)
    - script: |
        source venv/bin/activate  # Activate virtual environment
        pytest  # Or use your testing framework (unittest, nose, etc.)
      displayName: 'Run Python tests'

    # Publish the build artifact to be used in deployment
    - task: PublishBuildArtifacts@1
      inputs:
        PathtoPublish: '$(Build.SourcesDirectory)'  # Publish all source files
        ArtifactName: 'drop'  # Artifact name
        publishLocation: 'Container'  # Location to publish (Container for Azure DevOps artifacts)

- job: Deploy
  displayName: 'Deploy to Azure Web App'
  dependsOn: BuildAndDeploy
  steps:
  
    # Deploy the code to Azure Web App
    - task: AzureWebApp@1
      inputs:
        azureSubscription: $(azureSubscription)  # Azure service connection
        appName: $(appName)  # Azure Web App name
        resourceGroupName: $(resourceGroup)  # Resource group name
        package: $(Pipeline.Workspace)/drop  # Path to the artifact published earlier
        deploymentMethod: 'auto'  # Automatically detect the deployment method (e.g., zip, war)
